---
import { Image } from 'astro:assets';
import retail from '../assets/verticals/retail.jpg';
import restaurant from '../assets/verticals/restaurant.jpg';
import pharmacy from '../assets/verticals/pharmacy.jpg';
const scenes = [
 {key:'retail',label:'Retail',sw:'Maduka',photo:retail,title:'Every item. Every sale.',titleSw:'Kila bidhaa. Kila mauzo.',desc:'Barcodes, stock and your real profit — together.',descSw:'Misimbopau, stoki na faida yako halisi — pamoja.'},
 {key:'restaurant',label:'Restaurants',sw:'Migahawa',photo:restaurant,title:'From table to kitchen.',titleSw:'Kutoka mezani hadi jikoni.',desc:'Tables, kitchen tickets and recipe costs in one place.',descSw:'Meza, oda za jikoni na gharama za mapishi sehemu moja.'},
 {key:'pharmacy',label:'Pharmacies',sw:'Maduka ya dawa',photo:pharmacy,title:'Stay ahead of expiry.',titleSw:'Fuatilia muda wa dawa.',desc:'Track batches, expiry dates and stock with confidence.',descSw:'Fuatilia bechi, tarehe za mwisho na stoki kwa uhakika.'},
];
---
<section class="refresh-hero" aria-labelledby="hero-title">
 <div class="wrap refresh-hero-grid">
  <div class="refresh-copy">
   <div class="refresh-kicker"><span></span><span data-en="BUILT FOR BUSINESS IN TANZANIA" data-sw="KWA BIASHARA ZA TANZANIA">BUILT FOR BUSINESS IN TANZANIA</span></div>
   <h1 id="hero-title" data-en='One POS.<br/><em>Business in sync.</em>' data-sw='POS moja.<br/><em>Biashara pamoja.</em>'>One POS.<br/><em>Business in sync.</em></h1>
   <p class="refresh-intro" data-en="Bring sales, stock and real profit together. A point of sale that understands your business — from your first customer to your next branch." data-sw="Unganisha mauzo, stoki na faida halisi. Mfumo wa POS unaoielewa biashara yako — kutoka mteja wa kwanza hadi tawi linalofuata.">Bring sales, stock and real profit together. A point of sale that understands your business — from your first customer to your next branch.</p>
   <div class="refresh-actions"><a class="btn btn-primary btn-lg" href="https://app.biashara-pos.com" data-en="Start your free account ↗" data-sw="Fungua akaunti bure ↗">Start your free account ↗</a><a class="refresh-link" href="#industries" data-en="Find your business type ↓" data-sw="Chagua aina ya biashara ↓">Find your business type ↓</a></div>
   <p class="refresh-note" data-en="Free up to 1,000 sales / month. No credit card." data-sw="Bure hadi mauzo 1,000 / mwezi. Hakuna kadi ya benki.">Free up to 1,000 sales / month. No credit card.</p>
   <div class="refresh-promise"><span>01</span><p data-en="Smart business. Seamless sales." data-sw="Biashara bora. Mauzo rahisi.">Smart business. Seamless sales.</p></div>
  </div>
  <div class="refresh-visual">
   <div class="refresh-tabs" role="tablist" aria-label="Explore your industry">
    {scenes.map((s,i)=><button id={`tab-${s.key}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`scene-${s.key}`} tabindex={i===0?0:-1} data-scene={s.key} data-en={s.label} data-sw={s.sw}>{s.label}</button>)}
   </div>
   {scenes.map((s,i)=><div class="refresh-scene" id={`scene-${s.key}`} role="tabpanel" aria-labelledby={`tab-${s.key}`} hidden={i!==0}><Image src={s.photo} alt={`${s.label} business interior`} widths={[400,600,800]} sizes="(max-width: 800px) 100vw, 50vw" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'low'}/><div class="refresh-scene-caption"><span class="refresh-caption-icon">↗</span><div><strong data-en={s.title} data-sw={s.titleSw}>{s.title}</strong><p data-en={s.desc} data-sw={s.descSw}>{s.desc}</p></div></div></div>)}
   <div class="refresh-visual-foot"><span data-en="YOUR FLOOR. YOUR FLOW." data-sw="BIASHARA YAKO. MFUMO WAKO.">YOUR FLOOR. YOUR FLOW.</span><span>Biashara<span class="gold">POS</span></span></div>
  </div>
 </div>
 <div class="wrap refresh-proof"><div><b>01 /</b><span data-en="Sell on phone, POS or computer" data-sw="Uza kwa simu, POS au kompyuta">Sell on phone, POS or computer</span></div><div><b>02 /</b><span data-en="Keep counter sales moving offline" data-sw="Endelea kuuza kauntani bila mtandao">Keep counter sales moving offline</span></div><div><b>03 /</b><span data-en="Know your real profit per sale" data-sw="Jua faida halisi kwa kila mauzo">Know your real profit per sale</span></div></div>
</section>
<script>
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scene]'));
function selectTab(tab:HTMLButtonElement){tabs.forEach(t=>{const active=t===tab;t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1;const panel=document.getElementById('scene-'+t.dataset.scene);if(panel)panel.hidden=!active;});}
tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(tab));tab.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();let next=e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;selectTab(tabs[next]);tabs[next].focus();}});});
</script>
