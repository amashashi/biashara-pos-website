---
import { Image } from 'astro:assets';
import v3Front from '../assets/devices/sunmi-v3-plus-front.webp';
import flex3 from '../assets/devices/sunmi-flex3.webp';

const appUrl = 'https://app.biashara-pos.com';

/**
 * Device cluster. Reuses the mock styling from the Devices section
 * (.dev-term/.dev-phone/.scrn) rather than duplicating it, and shows a
 * tighter two-device composition so the full stage further down the page
 * still has something of its own to say. No image assets involved.
 */
---
<section class="hero hero-vision">
  <div class="wrap hero-center">
    <div class="brand-lockup reveal"><b>Biashara</b><i>POS</i></div>
    <div class="tagline reveal" data-en="Smart Business · Seamless Sales" data-sw="Biashara Bora · Mauzo Rahisi">Smart Business · Seamless Sales</div>
    <h1 class="reveal" data-en='One POS. <span class="grad">Every vertical.</span>' data-sw='POS moja. <span class="grad">Kila sekta.</span>'>One POS. <span class="grad">Every vertical.</span></h1>
    <p
      class="hero-sub reveal"
      data-en='A restaurant runs tables, a kitchen screen and recipe costs. A boutique runs variants and an online shop with delivery. A pharmacy runs batches and expiry. <b>Same system, same stock, same books.</b> <span class="sw">Biashara zako, mfumo mmoja.</span>'
      data-sw='Mgahawa unaendesha meza, skrini ya jikoni na gharama za mapishi. Boutique inaendesha saizi na rangi, pamoja na duka la mtandaoni lenye usafirishaji. Duka la dawa linaendesha bechi na tarehe za kuisha kwa dawa. <b>Mfumo mmoja, stoki moja, vitabu vilevile.</b> <span class="sw">Biashara zako, mfumo mmoja.</span>'
    >A restaurant runs tables, a kitchen screen and recipe costs. A boutique runs variants and an online shop with delivery. A pharmacy runs batches and expiry. <b>Same system, same stock, same books.</b> <span class="sw">Biashara zako, mfumo mmoja.</span></p>
    <div class="hero-cta reveal">
      <a class="btn btn-primary btn-lg" href={appUrl} data-en="Start for Free →" data-sw="Anza Bila Malipo →">Start for Free →</a>
      <a class="btn btn-ghost btn-lg" href="#modules" data-en="See the modules" data-sw="Ona moduli">See the modules</a>
    </div>
    <div class="hero-stage reveal" aria-hidden="true">
      <div class="hs-flex flex-shot">
        <Image src={flex3} alt="" widths={[300, 600]} sizes="300px" loading="eager" />
        <div class="flex-screen">
          <div class="kds-tabs"><i class="on">Jikoni</i><i>Grill</i><i>Bar</i><span>4 live</span></div>
          <div class="kds-cards">
            <div class="kc ok"><b>Meza D5</b><span>Nyama Choma ×2</span><em>02:10</em></div>
            <div class="kc warn"><b>Meza A3</b><span>Pilau ×2</span><em>06:48</em></div>
            <div class="kc late"><b>Takeaway 114</b><span>Mishkaki ×3</span><em>11:25</em></div>
            <div class="kc ok"><b>Meza C2</b><span>Samaki</span><em>01:04</em></div>
          </div>
        </div>
      </div>

      <div class="hs-term v3-shot">
        <Image src={v3Front} alt="" widths={[196, 392]} sizes="196px" loading="eager" />
        <div class="screen-space">
          <div class="screen-ui">
            <div class="su-bar"><b>Kaunta 1</b><span>live</span></div>
            <div class="su-rows">
              <div><span>Sukari 1kg</span><b>6,400</b></div>
              <div><span>Mafuta 2L</span><b>9,500</b></div>
              <div><span>Mchele 5kg</span><b>22,000</b></div>
            </div>
            <div class="su-total"><span>JUMLA</span><b>37,900</b></div>
            <div class="su-profit">Faida +5,180</div>
            <div class="su-pay"><i class="on">M-Pesa</i><i>Cash</i></div>
          </div>
        </div>
      </div>

      <div class="hs-phone">
        <div class="dev-phone">
          <div class="scrn">
            <div class="mini-bar"><div class="md"><i style="background:#ec6a5e"></i><i style="background:#f4bf4f"></i><i style="background:#61c454"></i></div><span class="mt">BiasharaPOS</span><span class="mst">● live</span></div>
            <div class="mini-profit"><div class="l" data-en="Net profit · this sale" data-sw="Faida halisi · mauzo haya">Net profit · this sale</div><div class="v">+TZS 4,200</div></div>
            <div class="mini-row"><span class="ic" style="background:linear-gradient(135deg,#dbe7fb,#fff)"></span><span class="nm">Cooking Oil 2L</span><span class="pr">9,500</span></div>
            <div class="mini-row"><span class="ic" style="background:linear-gradient(135deg,#e6f6ea,#fff)"></span><span class="nm">Rice 5kg</span><span class="pr">22,000</span></div>
            <div class="mini-btn" data-en="Charge sale" data-sw="Toza mauzo">Charge sale</div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-ticks reveal">
      <span class="tick"><span class="ic">✓</span><span data-en="Phone, POS terminal & computer" data-sw="Simu, terminal ya POS &amp; kompyuta">Phone, POS terminal &amp; computer</span></span>
      <span class="tick"><span class="ic">✓</span><span data-en="Counter sells without the network" data-sw="Kaunta inauza bila mtandao">Counter sells without the network</span></span>
      <span class="tick"><span class="ic">✓</span><span data-en="Real net profit per sale" data-sw="Faida halisi kwa kila mauzo">Real net profit per sale</span></span>
      <span class="tick"><span class="ic">✓</span><span data-en="Free up to 1,000 sales/mo" data-sw="Bure hadi mauzo 1,000/mwezi">Free up to 1,000 sales/mo</span></span>
    </div>
  </div>
</section>
