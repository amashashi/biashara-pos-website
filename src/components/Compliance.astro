 {en:{title:'Control staff access',desc:'Give staff access according to their role and responsibilities.'},sw:{title:'Dhibiti ufikiaji',desc:'Wape wafanyakazi ufikiaji kulingana na majukumu yao.'}},
 {en:{title:'Your payment accounts',desc:'Record payment references while customers pay through your existing arrangements.'},sw:{title:'Akaunti zako za malipo',desc:'Rekodi namba za malipo huku wateja wakilipa kupitia huduma zako zilizopo.'}},
 {en:{title:'Check local requirements',desc:'Ask us about your country’s tax-invoice requirements before choosing a plan.'},sw:{title:'Mahitaji ya nchi yako',desc:'Tuulize kuhusu mahitaji ya ankara za kodi nchini kwako kabla ya kuchagua kifurushi.'}}
