---
const appUrl = 'https://app.biashara-pos.com';
const plan = {
  en: {
    name: 'Free forever',
    price: 'TZS 0',
    per: '/mo',
    meta: 'Unlimited users · Unlimited devices',
    features: [
      'Full POS & sales tracking',
      'Real-time profit dashboard',
      'TRA audit PDF reports',
      'VFD fiscal receipts',
      'Inventory & expiry alerts',
      'Purchase orders',
      'Pharmacy & restaurant mode',
      'Advanced analytics',
      'M-Pesa, Mixx by Yas, Airtel, Visa, MC',
      'Works offline',
    ],
    cta: 'Create free account →',
  },
  sw: {
    name: 'Bure milele',
    price: 'TZS 0',
    per: '/mw',
    meta: 'Watumiaji wasio na kikomo · Vifaa visivyo na kikomo',
    features: [
      'POS kamili na ufuatiliaji wa mauzo',
      'Dashibodi ya faida ya wakati huo',
      'Ripoti za ukaguzi wa TRA PDF',
      'Risiti za kodi VFD',
      'Tahadhari za stoki na tarehe ya mwisho',
      'Maagizo ya ununuzi',
      'Hali ya duka la dawa na mgahawa',
      'Uchanganuzi wa hali ya juu',
      'M-Pesa, Mixx by Yas, Airtel, Visa, MC',
      'Inafanya kazi bila intaneti',
    ],
    cta: 'Fungua akaunti bila malipo →',
  },
};
---
<section class="sec sec-tint" id="pricing">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow center" data-en="100% free" data-sw="Bure kabisa">100% free</span>
      <h2 data-en="BiasharaPOS is completely free." data-sw="BiasharaPOS ni bure kabisa.">BiasharaPOS is completely free.</h2>
      <p
        data-en='No plans. No subscriptions. No hidden fees. Every feature, for every business — free forever, no strings attached. <span class="sw">Bure kabisa, hakuna masharti.</span>'
        data-sw='Hakuna vifurushi. Hakuna ada za kila mwezi. Hakuna gharama zilizofichwa. Kila kipengele, kwa kila biashara — bure milele, bila masharti yoyote. <span class="sw">Bure kabisa, hakuna masharti.</span>'
      >No plans. No subscriptions. No hidden fees. Every feature, for every business — free forever, no strings attached. <span class="sw">Bure kabisa, hakuna masharti.</span></p>
    </div>
    <div class="price-grid" style="grid-template-columns:minmax(0,520px);justify-content:center;">
      <div class="plan pop reveal">
        <span class="tagpop" data-en="★ Free forever — no strings attached" data-sw="★ Bure milele — bila masharti">★ Free forever — no strings attached</span>
        <div>
          <div class="pname" data-en={plan.en.name} data-sw={plan.sw.name}>{plan.en.name}</div>
          <div class="pprice">
            <span data-en={plan.en.price} data-sw={plan.sw.price}>{plan.en.price}</span><small data-en={plan.en.per} data-sw={plan.sw.per}>{plan.en.per}</small>
          </div>
        </div>
        <div class="pmeta" data-en={plan.en.meta} data-sw={plan.sw.meta}>{plan.en.meta}</div>
        <ul>
          {plan.en.features.map((feat, i) => (
            <li data-en={feat} data-sw={plan.sw.features[i]}>{feat}</li>
          ))}
        </ul>
        <a class="btn btn-primary" href={appUrl} data-en={plan.en.cta} data-sw={plan.sw.cta}>{plan.en.cta}</a>
      </div>
    </div>
    <p
      class="reveal"
      style="text-align:center;margin-top:22px;font-size:14px;color:var(--ink-3);font-weight:600;"
      data-en="No credit card · No trial that expires · No per-transaction fees, ever"
      data-sw="Hakuna kadi ya benki · Hakuna majaribio yanayoisha · Hakuna ada za kila muamala, kamwe"
    >No credit card · No trial that expires · No per-transaction fees, ever</p>
  </div>
</section>
