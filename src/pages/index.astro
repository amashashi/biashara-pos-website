---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProductPreview from '../components/ProductPreview.astro';
import Industries from '../components/Industries.astro';
import Modules from '../components/Modules.astro';
import Devices from '../components/Devices.astro';
import ProfitSpotlight from '../components/ProfitSpotlight.astro';
import Features from '../components/Features.astro';
import ShopBand from '../components/ShopBand.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Compliance from '../components/Compliance.astro';
import Pricing from '../components/Pricing.astro';
import TestimonialFAQ from '../components/TestimonialFAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="BiasharaPOS | POS Software for Businesses in Tanzania"
  description="Run sales, stock and profit in one POS system. BiasharaPOS supports retail, restaurants, pharmacies and more in Tanzania, with up to 1,000 sales a month free."
>
  <Nav />
  <main id="top">
    <Hero />
    <Industries />
    <ProductPreview />
    <Modules />
    <Devices />
    <ProfitSpotlight />
    <Features />
    <ShopBand />
    <HowItWorks />
    <Compliance />
    <Pricing />
    <TestimonialFAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
