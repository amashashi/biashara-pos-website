---
const faqs = [
  {
    en: { q: 'What happens when the internet goes down?', a: 'Counter sales keep working — they queue on the device and sync themselves the moment you are back online. Restaurant table service, the kitchen screen and online orders do need a connection, since several devices have to stay in step with each other.' },
    sw: { q: 'Nini kinatokea mtandao ukikatika?', a: 'Mauzo ya kaunta yanaendelea — yanahifadhiwa kwenye kifaa na kujisawazisha mara unaporejea mtandaoni. Huduma ya meza, skrini ya jikoni na oda za mtandaoni zinahitaji mtandao, kwa sababu vifaa kadhaa vinapaswa kuwa sambamba.' },
  },
  {
    // We are NOT TRA-certified. This answer must stay in the "built to the spec,
    // not certified by them" register — see src/components/Compliance.astro.
    en: { q: 'How does BiasharaPOS handle TRA receipts?', a: 'Every sale is issued a fiscal receipt number and queued for TRA submission, following the VFD specification, and your sales records export as an audit-ready PDF. BiasharaPOS itself is not certified by the TRA — you stay responsible for your own fiscalisation obligations.' },
    sw: { q: 'BiasharaPOS inashughulikiaje risiti za TRA?', a: 'Kila mauzo hupewa namba ya risiti ya kodi na kupangwa kutumwa TRA, kufuata maelekezo ya VFD, na kumbukumbu zako za mauzo husafirishwa kama PDF tayari kwa ukaguzi. BiasharaPOS yenyewe haijathibitishwa na TRA — wewe unabaki na jukumu la wajibu wako wa kodi.' },
  },
  {
    en: { q: 'Is there a mobile app?', a: 'Yes — BiasharaPOS runs on any phone, tablet or computer, with no special hardware required.' },
    sw: { q: 'Je, kuna app ya simu?', a: 'Ndio — BiasharaPOS inafanya kazi kwenye simu yoyote, kompyuta ndogo au kompyuta, bila vifaa maalumu.' },
  },
  {
    en: { q: 'Can I use it for my pharmacy / restaurant / supermarket?', a: 'Absolutely. Dedicated modes handle expiry & batches for pharmacies, tables & kitchen tickets for restaurants, and barcodes & bulk for retail.' },
    sw: { q: 'Je, naweza kuitumia kwa duka langu la dawa / mgahawa / soko?', a: 'Bila shaka. Hali maalumu zinashughulikia mwisho wa muda na bechi kwa maduka ya dawa, meza na tiketi za jikoni kwa migahawa, na misimbo na bulk kwa rejareja.' },
  },
  {
    // We do NOT process payments — these are tender types recorded at the till.
    // Money moves through the merchant's own M-Pesa/Mixx/Airtel account, not ours.
    en: { q: 'How are payments recorded?', a: 'You keep taking payment the way you already do — M-Pesa, Mixx by Yas, Airtel Money, cash or card — and record it against the sale, with the confirmation code if you want it. BiasharaPOS does not sit between you and your money, which is why there are no per-transaction charges, only the flat monthly fee.' },
    sw: { q: 'Malipo yanarekodiwaje?', a: 'Unaendelea kupokea malipo jinsi unavyofanya sasa — M-Pesa, Mixx by Yas, Airtel Money, pesa taslimu au kadi — na kuyarekodi kwenye mauzo, pamoja na namba ya uthibitisho ukitaka. BiasharaPOS haiingii kati yako na pesa yako, ndiyo maana hakuna ada za kila muamala, ni ada ya mwezi tu.' },
  },
];
---
<section class="sec sec-white" id="faq">
  <div class="wrap tf tf-solo">
    <!-- Customer testimonial removed: we do not hold permission to name or quote
         the business it was attributed to. Do not reinstate a named quote, a
         photo or a star rating without written permission from that customer. -->
    <div class="reveal">
      <span class="eyebrow" data-en="Got questions?" data-sw="Una maswali?">Got questions?</span>
      <h2 style="font-size:30px;margin:14px 0 22px;" data-en="Frequently asked" data-sw="Maswali yanayoulizwa mara kwa mara">Frequently asked</h2>
      <div class="faq-list" id="faqList">
        {faqs.map((f) => (
          <div class="faq">
            <button>
              <span data-en={f.en.q} data-sw={f.sw.q}>{f.en.q}</span>
              <span class="pls">+</span>
            </button>
            <div class="ans">
              <p data-en={f.en.a} data-sw={f.sw.a}>{f.en.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
