---
import { Image } from 'astro:assets';
import { verticals, verticalSlugs } from '../data/verticals';
import v3Front from '../assets/devices/sunmi-v3-plus-front.webp';
import flex3 from '../assets/devices/sunmi-flex3.webp';
import { kdsTickets, kdsVisible } from '../data/kds-tickets';

/** Kitchen tickets come from one list so the "N live" counter cannot drift
 *  from the number of cards drawn — it already had. */
const tix = kdsTickets.slice(0, kdsVisible);


/**
 * Hardware strip. Deliberately not another "every device" line — the
 * Devices section already makes that point. This one shows the SAME two
 * terminals carrying two different trades, which is the argument the
 * Industries grid above is making.
 */
---
<section class="sec sec-white" id="industries">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow center" data-en="Built for your floor" data-sw="Imejengwa kwa ajili yako">Built for your floor</span>
      <h2 data-en="Tuned for every vertical" data-sw="Imetengenezwa kwa kila sekta">Tuned for every vertical</h2>
      <p
        data-en='The same fast checkout, tailored to how your industry actually sells. <span class="sw">Kila biashara, mfumo mmoja.</span>'
        data-sw='Malipo haraka yale yale, yaliyobinafsishwa kwa jinsi sekta yako inavyouza. <span class="sw">Kila biashara, mfumo mmoja.</span>'
      >The same fast checkout, tailored to how your industry actually sells. <span class="sw">Kila biashara, mfumo mmoja.</span></p>
    </div>
    <div class="vgrid">
      {verticalSlugs.map((slug) => {
        const v = verticals[slug];
        return (
          <a class="vcard reveal" href={`/pos-for-${v.slug}`} aria-label={`${v.name.en} POS — learn more`}>
            <div class:list={['vimg', !v.photo && 'vimg-blank']}>
              {v.photo ? (
                <Image
                  src={v.photo}
                  alt={v.alt}
                  widths={[320, 480, 640, 800]}
                  sizes="(max-width: 560px) 100vw, (max-width: 880px) 50vw, (max-width: 1080px) 33vw, 220px"
                  loading="lazy"
                />
              ) : (
                <span class={`vimg-mark v-${v.badgeKey}`} role="img" aria-label={v.alt}
                  set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">${v.icon}</svg>`}></span>
              )}
              <span class={`vbadge v-${v.badgeKey}`} set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">${v.icon}</svg>`}></span>
            </div>
            <div class="vbody">
              <h3 data-en={v.name.en} data-sw={v.name.sw}>{v.name.en}</h3>
              <p data-en={v.shortDesc.en} data-sw={v.shortDesc.sw}>{v.shortDesc.en}</p>
            </div>
          </a>
        );
      })}
    </div>

    <div class="indev reveal">
      <div class="indev-copy">
        <h3
          data-en="Same two terminals. Whatever you sell."
          data-sw="Terminal mbili zile zile. Chochote unachouza."
        >Same two terminals. Whatever you sell.</h3>
        <p
          data-en="A pharmacy ringing up a prescription and a kitchen firing an order are the same hardware, running the screen each one needs."
          data-sw="Duka la dawa likiuza dawa, na mgahawa ukiandaa oda jikoni, vyote vinatumia vifaa vilevile — kila kimoja kikiendesha skrini kinayohitaji."
        >A pharmacy ringing up a prescription and a kitchen firing an order are the same hardware, running the screen each one needs.</p>
      </div>

      <div class="indev-pair">
        <div class="indev-one">
          <div class="v3-shot">
            <Image src={v3Front} alt="SUNMI V3 PLUS handheld running a pharmacy sale in BiasharaPOS" widths={[164, 328]} sizes="164px" loading="lazy" />
            <div class="screen-space" aria-hidden="true">
              <div class="screen-ui">
                <div class="su-bar"><b>Duka la dawa</b><span>live</span></div>
                <div class="su-rows">
                  <div><span>Paracetamol × 2</span><b>5,000</b></div>
                  <div><span>Amoxicillin</span><b>7,000</b></div>
                  <div><span>ORS Sachet × 3</span><b>3,600</b></div>
                </div>
                <div class="su-total"><span>JUMLA</span><b>15,600</b></div>
                <div class="su-profit">Faida +5,100</div>
                <div class="su-pay"><i class="on">M-Pesa</i><i>Cash</i></div>
              </div>
            </div>
          </div>
          <span class="indev-cap" data-en="Pharmacy · at the counter" data-sw="Duka la dawa · kaunta">Pharmacy · at the counter</span>
        </div>

        <div class="indev-one">
          <div class="flex-shot">
            <Image src={flex3} alt="SUNMI FLEX 3 running the BiasharaPOS kitchen screen in a restaurant" widths={[260, 520]} sizes="260px" loading="lazy" />
            <div class="flex-screen" aria-hidden="true">
              <div class="kds-tabs"><i class="on">Jikoni</i><i>Grill</i><i>Bar</i><span>{tix.length} live</span></div>
              <div class="kds-cards">
                {tix.map((t) => (
                  <div class={`kc ${t.state}`}><b>{t.table}</b>{t.items.map((i) => <span>{i}</span>)}<em>{t.elapsed}</em></div>
                ))}
              </div>
            </div>
          </div>
          <span class="indev-cap" data-en="Restaurant · in the kitchen" data-sw="Mgahawa · jikoni">Restaurant · in the kitchen</span>
        </div>
      </div>
    </div>
  </div>
</section>
